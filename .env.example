# Values for running on your machine (`pnpm dev`) against the Docker database
# (`docker compose up mysql`). Inside Docker Compose, hosts and ports are
# overridden in docker-compose.yml.
PORT=4003

DB_HOST=localhost
DB_PORT=3309
MYSQL_USER=inventory
MYSQL_PASSWORD=inventory
MYSQL_DATABASE=inventory

# auth-service's public keys, for checking admin tokens.
AUTH_JWKS_URL=http://localhost:4001/internal/.well-known/jwks.json
# Shared by all services for service-to-service calls. Required in production
# (at least 32 random characters, e.g. `openssl rand -base64 48`).
# SERVICE_TOKEN_SECRET=

# Stock hold while the customer pays, and how often stale holds are released.
RESERVATION_TTL_SECONDS=900
EXPIRY_SWEEP_SECONDS=30
# Grams left at which a product counts as running low.
DEFAULT_LOW_STOCK=2000
# Development only: grams each new product starts with. Must be 0 in production.
DEV_OPENING_STOCK=25000

# Who receives inventory events (reservation.expired → order-service).
ORDER_EVENTS_URL=http://localhost:4006/internal/events
# NOTIFICATION_EVENTS_URL=http://notification-service:4009/internal/events
EVENT_RETRY_DELAYS=5,15,30,60
